APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# Local infrastructure used by later semantic/corpus milestones.
DATABASE_URL=postgresql+psycopg://averis:averis@localhost:5432/averis
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=averis
MINIO_SECRET_KEY=change-me-local-only

# Optional local open-source AI runtime.
AI_PROVIDER=ollama
AI_REVISION_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=8

# Optional server-side Cloud AI runtime. Disabled by default.
# Keep AI_API_KEY only on the API host; never expose it through NEXT_PUBLIC_*.
AI_CLOUD_ENABLED=false
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_API_MODEL=openai/gpt-oss-20b
AI_CLOUD_TIMEOUT_SECONDS=30

AI_SEMANTIC_REVIEW_THRESHOLD=
AI_SEMANTIC_HIGH_REVIEW_THRESHOLD=
AI_SEMANTIC_CALIBRATION_ID=

CROSSREF_BASE_URL=https://api.crossref.org
CROSSREF_MAILTO=
CROSSREF_TIMEOUT_SECONDS=8

NEXT_PUBLIC_API_URL=http://localhost:8000

# Zero-cost student SaaS mode.
SAAS_MODE=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Server-only privileged key used by the signed billing webhook. Never expose it
# to Next.js and never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional subscriptions. Creem stays in test mode by default.
# Keep every value below on the Azure API host only. Billing remains disabled until
# all values are configured and the v43 Creem migration has been applied.
BILLING_ENABLED=false
BILLING_PROVIDER=creem
CREEM_API_BASE_URL=https://test-api.creem.io
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_STUDENT_MONTHLY=
CREEM_PRODUCT_STUDENT_YEARLY=
CREEM_PRODUCT_PRO_MONTHLY=
CREEM_PRODUCT_PRO_YEARLY=
BILLING_RETURN_URL=http://localhost:3000

# Public beta deployment boundary (documentation only; do not copy secrets here):
# APP_ENV=beta
# WEB_ORIGIN=https://teldigi5-wq.github.io
# SAAS_MODE=true
# NEXT_PUBLIC_API_URL=https://averis-api-beta-db36dd7d.azurewebsites.net
# BILLING_PROVIDER=creem
# CREEM_API_BASE_URL=https://test-api.creem.io
# BILLING_RETURN_URL=https://teldigi5-wq.github.io/averis-ai
#
# In beta/production WEB_ORIGIN must be an explicit HTTPS origin. Wildcard '*'
# and implicit legacy-host fallbacks are rejected by the API configuration.
