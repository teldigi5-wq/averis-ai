APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# Local infrastructure used by later semantic/corpus milestones.
DATABASE_URL=postgresql+psycopg://averis:averis@localhost:5432/averis
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=averis
MINIO_SECRET_KEY=change-me-local-only

# Optional local open-source AI runtime.
AI_PROVIDER=ollama
AI_REVISION_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=8

# Optional server-side Cloud AI runtime. Disabled by default.
# The sample targets Groq's OpenAI-compatible API and a model currently listed
# on its Free Plan. Provider limits/models can change, so verify the account is
# still on the free tier before enabling. Averis never performs a paid fallback.
# Keep AI_API_KEY only on the API host; never expose it through NEXT_PUBLIC_*.
AI_CLOUD_ENABLED=false
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_API_MODEL=openai/gpt-oss-20b
AI_CLOUD_TIMEOUT_SECONDS=30

# Leave semantic banding disabled until a labeled held-out benchmark has produced
# documented thresholds. Candidate semantic scores may still be displayed when
# AI_REVISION_ENABLED=true, but they do not change review bands without all 3.
AI_SEMANTIC_REVIEW_THRESHOLD=
AI_SEMANTIC_HIGH_REVIEW_THRESHOLD=
AI_SEMANTIC_CALIBRATION_ID=

# Crossref public REST API. No API key is required.
CROSSREF_BASE_URL=https://api.crossref.org
# Optional contact email for Crossref's polite pool / operational contact.
CROSSREF_MAILTO=
CROSSREF_TIMEOUT_SECONDS=8

NEXT_PUBLIC_API_URL=http://localhost:8000

# Zero-cost student SaaS mode. Leave false for offline/local development.
# Set true on the public API only after applying the Supabase migration.
SAAS_MODE=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may still expose an anon key; it is supported as fallback.
SUPABASE_ANON_KEY=

# Public browser values (the publishable/anon key is intentionally public;
# never expose a Supabase service_role/secret key to Next.js).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public beta deployment boundary (documentation only; do not copy secrets here):
# APP_ENV=beta
# WEB_ORIGIN=https://teldigi5-wq.github.io
# SAAS_MODE=true
# NEXT_PUBLIC_API_URL=https://averis-api-beta-db36dd7d.azurewebsites.net
#
# In beta/production WEB_ORIGIN must be an explicit HTTPS origin. Wildcard '*'
# and implicit legacy-host fallbacks are rejected by the API configuration.
